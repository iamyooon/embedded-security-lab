#!/usr/bin/expect -f
# 헤드리스로 QEMU 부팅 -> 게스트에서 LAB_CMD 실행 -> 종료.
# qemu-check.exp(xtest 전용)를 내 명령 실행용으로 줄인 것.
set timeout 300
set cmd $env(LAB_CMD)

log_file -a -noappend "serial0.log"
open "serial1.log" "w+"
spawn sh -c "$::env(QEMU) $::env(QEMU_CHECK_ARGS)"

expect {
	"Kernel panic"	{ puts "\n!!! kernel panic"; exit 1 }
	timeout		{ puts "\n!!! boot timeout"; exit 2 }
	"ogin:"
}
send -- "root\r"
expect "# "
send -- "export LD_LIBRARY_PATH=/lib:/lib/arm-linux-gnueabihf\r"
expect "# "

# LAB_SCRIPT (호스트 파일) 가 있으면 한 줄씩 보내고 프롬프트를 기다린다 (2026-11-18, 저장소 공격 데모)
if {[info exists ::env(LAB_SCRIPT)] && $::env(LAB_SCRIPT) ne ""} {
	set f [open $::env(LAB_SCRIPT) r]
	foreach line [split [read $f] "\n"] {
		if {[string trim $line] eq "" || [string index [string trim $line] 0] eq "#"} { continue }
		send -- "$line\r"
		expect -re {\r\n# $}
	}
	close $f
	set cmd "true"
}

puts "\n--- guest: $cmd ---"
send -- "$cmd; echo LAB_EXIT=\$?\r"
set rc 99
expect {
	-re {LAB_EXIT=(\d+)}	{ set rc $expect_out(1,string) }
	timeout			{ puts "\n!!! command timeout"; exit 2 }
}
expect "# "
send -- "poweroff -f\r"
set timeout 20
expect eof
exit $rc
